// Windows resource script for Indigenous GCS.
//
// Embeds the application icon and version metadata into IndigenousGCS.exe so
// the executable shows the correct icon in Explorer, the taskbar and the
// Alt-Tab switcher, and carries a proper version resource for the installer.
//
// Compiled by CMake/RC automatically on WIN32 builds — nothing to do manually.

#include <windows.h>

// Resource identifier for the application icon.
#define IDI_APP_ICON 101

// Icon shown for the executable itself. Multiple sizes are embedded in the
// .ico so Windows can pick the right one per DPI and context.
IDI_APP_ICON ICON "app_icon.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,0,0,0
    PRODUCTVERSION  1,0,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"   // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "Indigenous GCS"
            VALUE "FileDescription",  "Cross-platform Ground Control Station for Indigenous ESP32 Flight Controllers"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "IndigenousGCS"
            VALUE "LegalCopyright",   "Indigenous GCS Contributors"
            VALUE "OriginalFilename", "IndigenousGCS.exe"
            VALUE "ProductName",      "Indigenous GCS"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END